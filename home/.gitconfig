[user]
	name = Ugo Thevenin
	email = ugo.mateda@gmail.com
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
	navigate = true
	dark = true
	line-numbers = true
	hyperlinks = true
	side-by-side = false
	syntax-theme = gruvbox-light
	file-style = "bold #076678"
	file-decoration-style = none
	hunk-header-style = syntax
	line-numbers-left-style = "#665c54"
	line-numbers-right-style = "#665c54"
	line-numbers-minus-style = "#9d0006"
	line-numbers-plus-style = "#79740e"
	minus-style = "syntax #ebdbb2"
	minus-emph-style = "syntax #d5c4a1"
	plus-style = "syntax #ebdbb2"
	plus-emph-style = "syntax #d5c4a1"
