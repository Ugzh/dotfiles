[user]
	name = Ugo Thevenin
	email = ugo.mateda@gmail.com
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
	navigate = true
	dark = true
	line-numbers = true
	hyperlinks = true
	side-by-side = false
	syntax-theme = Catppuccin Mocha
	file-style = "bold #b4befe"
	file-decoration-style = none
	hunk-header-style = syntax
	line-numbers-left-style = "#9399b2"
	line-numbers-right-style = "#9399b2"
	line-numbers-minus-style = "#f38ba8"
	line-numbers-plus-style = "#a6e3a1"
	minus-style = "syntax #181825"
	minus-emph-style = "syntax #45475a"
	plus-style = "syntax #181825"
	plus-emph-style = "syntax #313244"
