#!/usr/bin/env sh
set -eu

log_file=/tmp/power-menu.log

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$log_file"
}

run() {
  log "run: $*"
  if "$@" >> "$log_file" 2>&1; then
    exit 0
  else
    status=$?
    notify-send "Power menu failed" "$* exited with $status"
    exit "$status"
  fi
}

menu() {
  fuzzel --dmenu \
    --prompt='power ❯ ' \
    --placeholder='Press 1-5...' \
    --lines=6 \
    --width=30 \
    --auto-select \
    --no-sort
}

confirm() {
  action=$1
  choice=$(printf '1 Yes\n0 Cancel\n' | fuzzel --dmenu \
    --prompt="$action ❯ " \
    --placeholder='Press 1 or 0...' \
    --lines=2 \
    --width=30 \
    --auto-select \
    --no-sort) || exit 0

  [ "$choice" = '1 Yes' ]
}

action=$(printf '%s\n' \
  '1 Lock' \
  '2 Suspend' \
  '3 Logout' \
  '4 Reboot' \
  '5 Poweroff' \
  '0 Cancel' | menu) || exit 0

case "$action" in
  '1 Lock')
    exec gtklock
    ;;
  '2 Suspend')
    gtklock --daemonize
    run systemctl -i suspend
    ;;
  '3 Logout')
    confirm 'logout' || exit 0
    run niri msg action quit
    ;;
  '4 Reboot')
    confirm 'reboot' || exit 0
    run systemctl -i reboot
    ;;
  '5 Poweroff')
    confirm 'poweroff' || exit 0
    run systemctl -i poweroff
    ;;
  '0 Cancel'|*)
    exit 0
    ;;
esac
