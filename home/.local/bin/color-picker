#!/usr/bin/env sh
set -eu

missing=
for dependency in grim slurp magick wl-copy notify-send; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    missing="$missing $dependency"
  fi
done

if [ -n "$missing" ]; then
  notify-send "Color picker unavailable" "Missing:$missing"
  exit 1
fi

geometry=$(slurp -p) || exit 0

if [ -z "$geometry" ]; then
  exit 0
fi

rgb=$(grim -g "$geometry" -t ppm - | magick ppm:- -format '%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]' info:-)

old_ifs=$IFS
IFS=,
set -- $rgb
IFS=$old_ifs

color=$(printf '#%02x%02x%02x' "$1" "$2" "$3")

printf '%s' "$color" | wl-copy
notify-send "Color copied" "$color"
