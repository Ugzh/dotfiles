# Generated by apply-theme. Edit starship.toml.tmpl, not starship.toml.
add_newline = true
palette = "desktop"

format = "$username$hostname$directory$git_branch$git_status$nodejs$cmd_duration$status$line_break$character"

[username]
show_always = true
format = "[ugzher]($style)"
style_user = "accent"
style_root = "red"

[hostname]
ssh_only = false
trim_at = "."
format = "[:: ](fg_dim)"
style = "fg_dim"

[directory]
format = "[\\[$path\\] ]($style)"
style = "bright"
truncation_length = 3
truncate_to_repo = true
read_only = "󰌾"

[git_branch]
symbol = ""
format = "[\\[$symbol$branch\\] ]($style)"
style = "cyan"
truncation_length = 32
truncation_symbol = "…"

[git_status]
format = "([$all_status$ahead_behind ]($style))"
style = "pink"
conflicted = "\\[≠${count}\\]"
ahead = "\\[⇡${count}\\]"
behind = "\\[⇣${count}\\]"
diverged = "\\[⇕⇡${ahead_count}⇣${behind_count}\\]"
untracked = "\\[?${count}\\]"
stashed = "\\[󰏗${count}\\]"
modified = "\\[!${count}\\]"
staged = "\\[+${count}\\]"
renamed = "\\[»${count}\\]"
deleted = "\\[✘${count}\\]"

[nodejs]
symbol = ""
format = "[\\[$symbol$version\\] ]($style)"
style = "cyan"
not_capable_style = "cyan"

[cmd_duration]
min_time = 0
show_milliseconds = false
format = "[\\[󱑆$duration\\] ]($style)"
style = "warning"

[status]
disabled = false
format = "[\\[$symbol$status\\] ]($style)"
symbol = "✘"
style = "red"

[character]
format = "$symbol"
success_symbol = "[➜ ](bold cyan)"
error_symbol = "[➜ ](bold red)"
vimcmd_symbol = "[➜ ](bold bright)"
vimcmd_replace_one_symbol = "[➜ ](bold warning)"
vimcmd_replace_symbol = "[➜ ](bold warning)"
vimcmd_visual_symbol = "[➜ ](bold pink)"

[palettes.desktop]
accent = "#${THEME_ACCENT}"
bright = "#${THEME_BRIGHT}"
cyan = "#${THEME_CYAN}"
green = "#${THEME_GREEN}"
pink = "#${THEME_PINK}"
red = "#${THEME_RED}"
warning = "#${THEME_WARNING}"
fg_dim = "#${THEME_FG_DIM}"
