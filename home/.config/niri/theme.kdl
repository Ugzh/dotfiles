// Generated by apply-theme. Edit ~/.config/theme/presets/*.env instead.
layout {
    focus-ring {
        width 3
        active-gradient from="#cba6f7" to="#b4befe" angle=45
        inactive-color "#6c7086"
    }

    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=6
        color "#11111b99"
    }
}

cursor {
    xcursor-theme "catppuccin-mocha-mauve-cursors"
    xcursor-size 24
}

