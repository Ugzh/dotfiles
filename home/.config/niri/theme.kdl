// Generated by apply-theme. Edit ~/.config/theme/presets/*.env instead.
layout {
    focus-ring {
        width 3
        active-gradient from="#c7f36b" to="#c6a0f6" angle=45
        inactive-color "#643b72"
    }

    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=6
        color "#f15bb54d"
    }
}

cursor {
    xcursor-theme "catppuccin-mocha-mauve-cursors"
    xcursor-size 24
}

