// Generated by apply-theme. Edit ~/.config/theme/presets/*.env instead.
layout {
    focus-ring {
        width 3
        active-gradient from="#${THEME_ACCENT}" to="#${THEME_BRIGHT}" angle=45
        inactive-color "#${THEME_BORDER}"
    }

    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=6
        color "#${THEME_SHADOW}"
    }
}

cursor {
    xcursor-theme "${THEME_CURSOR}"
    xcursor-size ${THEME_CURSOR_SIZE}
}

