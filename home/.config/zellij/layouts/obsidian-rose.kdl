// Compact one-line layout powered by zjstatus.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left "{mode} #[bg=#17111e,fg=#c6a0f6,bold] {session} "
                format_center "{tabs}"
                format_right "{command_git_branch} {datetime}"
                format_space "#[bg=#0d0911]"

                border_enabled "false"
                hide_frame_for_single_pane "false"

                mode_normal "#[bg=#c7f36b,fg=#0d0911,bold] NORMAL "
                mode_locked "#[bg=#ff6e9e,fg=#0d0911,bold] LOCKED "
                mode_pane "#[bg=#bda0ef,fg=#0d0911,bold] PANE "
                mode_tab "#[bg=#c6a0f6,fg=#0d0911,bold] TAB "
                mode_resize "#[bg=#e8b4ff,fg=#0d0911,bold] RESIZE "
                mode_move "#[bg=#f15bb5,fg=#0d0911,bold] MOVE "
                mode_scroll "#[bg=#bda0ef,fg=#0d0911,bold] SCROLL "
                mode_search "#[bg=#e8b4ff,fg=#0d0911,bold] SEARCH "
                mode_session "#[bg=#f15bb5,fg=#0d0911,bold] SESSION "
                mode_tmux "#[bg=#b7a7bd,fg=#0d0911,bold] TMUX "

                tab_normal "#[fg=#b7a7bd] {index}:{name} "
                tab_active "#[bg=#251a30,fg=#c7f36b,bold] {index}:{name} "
                tab_separator "#[fg=#643b72]│"

                command_git_branch_command "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format "#[fg=#bda0ef] {stdout}"
                command_git_branch_interval "10"
                command_git_branch_rendermode "static"
                command_git_branch_cwd "{focused_pane_cwd}"

                datetime "#[fg=#b7a7bd,bold] {format} "
                datetime_format "%H:%M"
                datetime_timezone "Europe/Paris"
            }
        }
    }
}
