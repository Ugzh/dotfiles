// Generated by apply-theme. Compact one-line layout powered by zjstatus.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left "{mode} #[bg=#${THEME_BG_ALT},fg=#${THEME_BRIGHT},bold] {session} "
                format_center "{tabs}"
                format_right "{command_git_branch} {datetime}"
                format_space "#[bg=#${THEME_BG}]"

                border_enabled "false"
                hide_frame_for_single_pane "false"

                mode_normal "#[bg=#${THEME_ACCENT},fg=#${THEME_BG},bold] NORMAL "
                mode_locked "#[bg=#${THEME_RED},fg=#${THEME_BG},bold] LOCKED "
                mode_pane "#[bg=#${THEME_BLUE},fg=#${THEME_BG},bold] PANE "
                mode_tab "#[bg=#${THEME_MAGENTA},fg=#${THEME_BG},bold] TAB "
                mode_resize "#[bg=#${THEME_WARNING},fg=#${THEME_BG},bold] RESIZE "
                mode_move "#[bg=#${THEME_PINK},fg=#${THEME_BG},bold] MOVE "
                mode_scroll "#[bg=#${THEME_BLUE},fg=#${THEME_BG},bold] SCROLL "
                mode_search "#[bg=#${THEME_WARNING},fg=#${THEME_BG},bold] SEARCH "
                mode_session "#[bg=#${THEME_PINK},fg=#${THEME_BG},bold] SESSION "
                mode_tmux "#[bg=#${THEME_FG_DIM},fg=#${THEME_BG},bold] TMUX "

                tab_normal "#[fg=#${THEME_FG_DIM}] {index}:{name} "
                tab_active "#[bg=#${THEME_BG_HIGHLIGHT},fg=#${THEME_ACCENT},bold] {index}:{name} "
                tab_separator "#[fg=#${THEME_BORDER}]│"

                command_git_branch_command "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format "#[fg=#${THEME_BLUE}] {stdout}"
                command_git_branch_interval "10"
                command_git_branch_rendermode "static"
                command_git_branch_cwd "{focused_pane_cwd}"

                datetime "#[fg=#${THEME_FG_DIM},bold] {format} "
                datetime_format "%H:%M"
                datetime_timezone "Europe/Paris"
            }
        }
    }
}
